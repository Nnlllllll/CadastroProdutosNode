<h1>Novo produto</h1>

<form action="/produtos" method="POST">

    <label>Nome:</label>
    <input type="text" name="nome">

    <br>

    <label>Preço:</label>
    <input type="number" name="preco" step="0.01">

    <br>

    <label>Quantidade:</label>
    <input type="number" name="quantidade">

    <br>

    <button type="submit">
        Salvar
    </button>

</form>